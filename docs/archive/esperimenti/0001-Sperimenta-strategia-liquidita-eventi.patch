diff --git a/src/services/opportunityScoring.js b/src/services/opportunityScoring.js
new file mode 100644
index 0000000..1a0c7b9
--- /dev/null
+++ b/src/services/opportunityScoring.js
@@ -0,0 +1,114 @@
+import { applyExecutionCosts } from './executionCosts.js'
+import { getTickerCurrency } from './marketUniverse.js'
+
+const MIN_EXPECTED_NET_PCT = 0.35
+const MIN_NET_TO_COST_RATIO = 1.15
+
+function finiteNumber(value, fallback = 0) {
+  const number = Number(value)
+
+  return Number.isFinite(number) ? number : fallback
+}
+
+export function getTradeTargetProfile(atrPct, strategyId = 'equities') {
+  if (strategyId === 'crypto') {
+    return {
+      maxTargetPct: atrPct < 4 ? 0.45 : 0.65,
+      stopMultiplier: 1.8,
+      targetPct: atrPct < 4 ? 0.45 : 0.65,
+      trailingPct: null,
+    }
+  }
+
+  const calm = atrPct < 1.5
+
+  return {
+    maxTargetPct: calm ? 1.8 : 2.4,
+    stopMultiplier: calm ? 1.2 : 1.5,
+    targetPct: calm ? 1 : 1.4,
+    trailingPct: calm ? 0.45 : 0.65,
+  }
+}
+
+export function assessOpportunityNetEdge(row, strategy, notionalEur, type) {
+  if (!row || strategy?.id === 'crypto') {
+    return { passed: true, reason: null }
+  }
+
+  const price = finiteNumber(row.currentPrice)
+  const atr = finiteNumber(row.atr)
+  const fxToEur = finiteNumber(row.fxToEur, 1)
+  const invested = finiteNumber(notionalEur)
+
+  if (price <= 0 || atr <= 0 || invested <= 0 || !['LONG', 'SHORT'].includes(type)) {
+    return { passed: false, reason: 'Dati insufficienti per stimare margine netto e costi.' }
+  }
+
+  const atrPct = (atr / price) * 100
+  const target = getTradeTargetProfile(atrPct, strategy?.id)
+  const currency = row.currency || getTickerCurrency(row.ticker)
+  const openCosts = applyExecutionCosts({
+    atr,
+    currency,
+    fxToEur,
+    marketId: strategy?.id || 'equities',
+    notionalEur: invested,
+    phase: 'OPEN',
+    price,
+    ticker: row.ticker,
+    type,
+  })
+  const entryPrice = finiteNumber(openCosts.effectivePrice)
+  const entryPriceEur = finiteNumber(openCosts.effectivePriceEur)
+  const quantity = entryPriceEur > 0 ? invested / entryPriceEur : 0
+  const targetPrice =
+    type === 'LONG'
+      ? entryPrice * (1 + target.targetPct / 100)
+      : entryPrice * (1 - target.targetPct / 100)
+
+  if (quantity <= 0 || targetPrice <= 0) {
+    return { passed: false, reason: 'Quantità o target non calcolabile.' }
+  }
+
+  const closeCosts = applyExecutionCosts({
+    atr,
+    currency,
+    fxToEur,
+    marketId: strategy?.id || 'equities',
+    notionalEur: targetPrice * fxToEur * quantity,
+    phase: 'CLOSE',
+    price: targetPrice,
+    ticker: row.ticker,
+    type,
+  })
+  const exitPriceEur = finiteNumber(closeCosts.effectivePriceEur)
+  const grossPnlEur =
+    type === 'LONG'
+      ? (exitPriceEur - entryPriceEur) * quantity
+      : (entryPriceEur - exitPriceEur) * quantity
+  const commissions =
+    finiteNumber(openCosts.commissionEur) + finiteNumber(closeCosts.commissionEur)
+  const priceDrag =
+    finiteNumber(openCosts.pricePenaltyEur) * quantity +
+    finiteNumber(closeCosts.pricePenaltyEur) * quantity
+  const totalCosts = commissions + priceDrag
+  const expectedNetPnl = grossPnlEur - commissions
+  const expectedNetPct = (expectedNetPnl / invested) * 100
+  const netToCostRatio = totalCosts > 0 ? expectedNetPnl / totalCosts : Infinity
+  const passed =
+    expectedNetPct >= MIN_EXPECTED_NET_PCT &&
+    netToCostRatio >= MIN_NET_TO_COST_RATIO
+
+  return {
+    expectedNetPct,
+    expectedNetPnl,
+    netToCostRatio,
+    passed,
+    reason: passed
+      ? null
+      : `Margine netto stimato troppo basso: ${expectedNetPct.toFixed(
+          2,
+        )}% netto, rapporto utile/costi ${netToCostRatio.toFixed(2)}.`,
+    totalCosts,
+  }
+}
